[Desktop Entry]
Type=Application
Name=Shotlet
Comment=Wayland-native screenshots with annotation editor
Exec=shotlet --daemon
Icon=io.github.midnattsol.Shotlet
Terminal=false
Categories=Utility;Graphics;
StartupNotify=false
StartupWMClass=io.github.midnattsol.Shotlet
X-GNOME-UsesNotifications=true
# KWin lets the app whose executable matches Exec take screenshots without
# a dialog (install.sh makes Exec an absolute path)
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
Actions=Screenshot;History;Settings;

[Desktop Action Screenshot]
Name=Take screenshot
Exec=shotlet

[Desktop Action History]
Name=Recent captures
Exec=shotlet history

[Desktop Action Settings]
Name=Settings
Exec=shotlet settings
